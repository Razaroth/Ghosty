# Maintainer: Razaroth <jlester319@gmail.com>

pkgname=ghosty
pkgver=1.0.1
pkgrel=1
pkgdesc="Per-window transparency for KDE Plasma - a cute ghost in your system tray"
arch=('x86_64')
url="https://github.com/Razaroth/Ghosty"
license=('MIT')
depends=('qt6-base')
makedepends=('qt6-base')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Razaroth/Ghosty/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e4dfe8462d40b1f9fb30b8bdbd2eb2b1d237eb9b1a4bd397d31852266fe82e57')

build() {
    cd "$srcdir/Ghosty-$pkgver"
    qmake6 PREFIX=/usr opacity-slider.pro
    make
}

package() {
    cd "$srcdir/Ghosty-$pkgver"
    make INSTALL_ROOT="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}